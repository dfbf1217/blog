---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { ui, base, categories, type Lang } from '../i18n/ui';
interface Props {
  category?: string; // 사이드바에서 강조할 카테고리
  lang: Lang;
  title: string;
  description: string;
  path: string; // 언어 prefix 제외 경로, 예: "/" 또는 "/posts/slug/"
  altPath?: string; // 다른 언어 번역본 경로(있을 때만)
  type?: 'website' | 'article';
  date?: Date;
}
const { lang, title, description, path, altPath, type = 'website', date, category } = Astro.props;
const t = ui[lang];
const langPosts = (await getCollection('posts')).filter((p) => p.data.lang === lang);
const catCounts = categories.map((c) => ({ ...c, count: langPosts.filter((p) => p.data.category === c.slug).length }));
const isHome = path === '/';
const site = Astro.site!.origin;
const url = (l: string, p: string) => `${site}${base}/${l}${p}`;
const canonical = url(lang, path);
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const pageTitle = path === '/' ? t.siteTitle : `${title} | ${t.siteTitle}`;
const ld = type === 'article'
  ? { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description, inLanguage: lang, datePublished: date?.toISOString(), mainEntityOfPage: canonical }
  : { '@context': 'https://schema.org', '@type': 'Blog', name: t.siteTitle, inLanguage: lang, url: canonical };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    {altPath && <link rel="alternate" hreflang={other} href={url(other, altPath)} />}
    <link rel="alternate" type="application/rss+xml" title={t.siteTitle} href={`${base}/${lang}/rss.xml`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:site_name" content={t.siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <!-- 저장된 테마(없으면 다크)를 렌더 전에 적용해 깜빡임 방지 -->
    <script is:inline>
      let theme = 'dark';
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') theme = t; } catch {}
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`${base}/${lang}/`}>{t.siteTitle}<span>.</span></a>
        <nav class="nav">
          <a href={`${base}/${lang}/rss.xml`}>RSS</a>
          <button class="theme-toggle" type="button" aria-label="다크/라이트 모드 전환" title="다크/라이트 모드 전환">
            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <div class="layout">
      <aside class="sidebar">
        <nav class="cat-nav" aria-label={t.categories}>
          <div class="cat-nav-title">{t.categories}</div>
          <a href={`${base}/${lang}/`} aria-current={isHome ? 'page' : undefined}>
            <span>{t.all}</span><span class="count">{langPosts.length}</span>
          </a>
          {catCounts.map((c) => c.count > 0 ? (
            <a href={`${base}/${lang}/category/${c.slug}/`} aria-current={category === c.slug ? 'page' : undefined}>
              <span>{c[lang]}</span><span class="count">{c.count}</span>
            </a>
          ) : (
            <span class="disabled"><span>{c[lang]}</span><span class="count">0</span></span>
          ))}
        </nav>
      </aside>
      <main><slot /></main>
    </div>
    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()}</span>
        <div class="links">
          <a href="https://github.com/dfbf1217" rel="me">GitHub</a>
          <a href={`${base}/${lang}/rss.xml`}>RSS</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = (root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        const giscus = document.querySelector('iframe.giscus-frame');
        giscus?.contentWindow.postMessage({ giscus: { setConfig: { theme: next } } }, 'https://giscus.app');
      });
    </script>
    <!-- Cloudflare Web Analytics -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "7977fcd2f451433692c51d238f0e335b"}'></script>
  </body>
</html>
