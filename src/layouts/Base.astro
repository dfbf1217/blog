---
import { ui, languages, base, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // 언어 prefix 제외 경로, 예: "/" 또는 "/posts/slug/"
  altPath?: string; // 다른 언어 번역본 경로(있을 때만)
  type?: 'website' | 'article';
  date?: Date;
}
const { lang, title, description, path, altPath, type = 'website', date } = Astro.props;
const t = ui[lang];
const site = Astro.site!.origin;
const url = (l: string, p: string) => `${site}${base}/${l}${p}`;
const canonical = url(lang, path);
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const ld = type === 'article'
  ? { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description, inLanguage: lang, datePublished: date?.toISOString(), mainEntityOfPage: canonical }
  : { '@context': 'https://schema.org', '@type': 'Blog', name: t.siteTitle, inLanguage: lang, url: canonical };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    {altPath && <link rel="alternate" hreflang={other} href={url(other, altPath)} />}
    <link rel="alternate" type="application/rss+xml" title={t.siteTitle} href={`${base}/${lang}/rss.xml`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <style>
      :root { color-scheme: light dark; }
      body { max-width: 42rem; margin: 0 auto; padding: 1rem 1rem 4rem; font: 17px/1.75 system-ui, -apple-system, 'Segoe UI', sans-serif; }
      header { display: flex; justify-content: space-between; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid #8884; margin-bottom: 2rem; }
      header a { text-decoration: none; }
      .brand { font-weight: 700; font-size: 1.15rem; }
      pre { overflow-x: auto; padding: 1rem; background: #8881; border-radius: 6px; font-size: 0.9rem; }
      code { font-size: 0.92em; }
      img { max-width: 100%; }
      .meta { color: #888; font-size: 0.9rem; }
      ul.posts { list-style: none; padding: 0; }
      ul.posts li { margin: 1.5rem 0; }
      ul.posts a { font-weight: 600; font-size: 1.1rem; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href={`${base}/${lang}/`}>{t.siteTitle}</a>
      <nav>
        <a href={`${base}/${other}${altPath ?? '/'}`} hreflang={other}>{languages[other]}</a>
      </nav>
    </header>
    <main><slot /></main>
  </body>
</html>
