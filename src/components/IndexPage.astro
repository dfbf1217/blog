---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ui, base, slugOf, readingMinutes, fmtDate, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = (await getCollection('posts'))
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => +b.data.date - +a.data.date);
---
<Base lang={lang} title={t.siteTitle} description={t.tagline} path="/">
  <section class="hero">
    <h1>{t.heroTitle}</h1>
    <p>{t.tagline}</p>
  </section>

  <h2 class="section-title">{t.latest}</h2>
  {posts.length === 0 ? <p class="empty">{t.empty}</p> : (
    <ul class="post-list">
      {posts.map((p) => (
        <li class="post-item">
          <a href={`${base}/${lang}/posts/${slugOf(p.id)}/`}>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <div class="meta">
              <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, lang)}</time>
              <span class="dot" />
              <span>{t.minRead(readingMinutes(p.body, lang))}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
