---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ui, base, slugOf, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = (await getCollection('posts'))
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => +b.data.date - +a.data.date);
---
<Base lang={lang} title={t.siteTitle} description={t.tagline} path="/">
  <p>{t.tagline}</p>
  <h2>{t.latest}</h2>
  {posts.length === 0 ? <p>{t.empty}</p> : (
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a href={`${base}/${lang}/posts/${slugOf(p.id)}/`}>{p.data.title}</a>
          <div class="meta"><time datetime={p.data.date.toISOString()}>{p.data.date.toISOString().slice(0, 10)}</time></div>
          <div>{p.data.description}</div>
        </li>
      ))}
    </ul>
  )}
</Base>
