---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Comments from './Comments.astro';
import { ui, base, slugOf, readingMinutes, fmtDate, type Lang } from '../i18n/ui';
const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const t = ui[lang];
const all = await getCollection('posts');
const post = all.find((p) => p.data.lang === lang && slugOf(p.id) === slug)!;
const { Content } = await render(post);
// 번역본 연결: 내가 translationOf를 갖고 있거나, 상대가 나를 가리키는 경우
const alt = all.find(
  (p) => p.data.lang !== lang && (slugOf(p.id) === post.data.translationOf || p.data.translationOf === slug),
);
const altPath = alt ? `/posts/${slugOf(alt.id)}/` : undefined;
---
<Base lang={lang} title={post.data.title} description={post.data.description} path={`/posts/${slug}/`} altPath={altPath} type="article" date={post.data.date}>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date, lang)}</time>
        <span class="dot" />
        <span>{t.minRead(readingMinutes(post.body, lang))}</span>
      </div>
      {post.data.tags.length > 0 && (
        <div class="tags">{post.data.tags.filter((tag) => tag !== 'intro').map((tag) => <span class="tag">#{tag}</span>)}</div>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Comments lang={lang} />
  <footer class="post-footer">
    <a class="back-link" href={`${base}/${lang}/`}>{t.back}</a>
  </footer>
</Base>
